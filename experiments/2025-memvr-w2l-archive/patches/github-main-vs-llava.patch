+def encode_base64(image):
+    """
+    Encodes a PIL image to a base64 string.
+    """
+    buffered = BytesIO()
+    image.save(buffered, format="PNG")
+    img_str = base64.b64encode(buffered.getvalue()).decode()
+    return img_str
