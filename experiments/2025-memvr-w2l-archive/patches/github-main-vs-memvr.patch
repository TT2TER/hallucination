+def activate_memvr(
+        self,
+        enable: bool = True,
+    ):
+    """
+    Activate or deactivate MemVR in the model.
+    """
+    if enable:
+        self.model.layers[0].mlp.apply_memvr = True
+    else:
+        self.model.layers[0].mlp.apply_memvr = False
